<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="horeca-vergunning-info-participant" name="Horeca Vergunning info" processRef="horeca-vergunning-info" />
  </bpmn:collaboration>
  <bpmn:process id="horeca-vergunning-info" name="Horeca Vergunning info" isExecutable="true">
    <bpmn:startEvent id="start-event" name="Process started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="query-horeca-vergunning" name="Haal horeca vergunning op via Hasura met process variable">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start-event" targetRef="query-horeca-vergunning" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="query-horeca-vergunning" targetRef="end-event" />
    <bpmn:endEvent id="end-event" name="Process ended">
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript"><![CDATA[
function toJs(value) {
  if (value === null || value === undefined) {
    return null;
  }
  if (typeof value !== 'object') {
    return value;
  }
  if (typeof value.entrySet === 'function') {
    var result = {};
    var iterator = value.entrySet().iterator();
    while (iterator.hasNext()) {
      var entry = iterator.next();
      result[String(entry.getKey())] = toJs(entry.getValue());
    }
    return result;
  }
  if (typeof value.size === 'function' && typeof value.get === 'function') {
    var list = [];
    for (var i = 0; i < value.size(); i++) {
      list.push(toJs(value.get(i)));
    }
    return list;
  }
  return String(value);
}
execution.setVariable('horecaQueryResultJson', JSON.stringify(toJs(execution.getVariable('horecaQueryResult')), null, 2));
]]></camunda:script>
        </camunda:executionListener>
        <camunda:executionListener expression="${valueResolverDelegateService.handleValue(execution, &#39;doc:/horecaData&#39;, execution.getVariable(&#39;horecaQueryResult&#39;))}" event="start" />
        <camunda:executionListener expression="${valueResolverDelegateService.handleValue(execution, &#39;doc:/horecaDataJson&#39;, execution.getVariable(&#39;horecaQueryResultJson&#39;))}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="horeca-vergunning-info-participant" isHorizontal="true">
        <dc:Bounds x="160" y="100" width="1000" height="200" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="start-event">
        <dc:Bounds x="232" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="214" y="225" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_1_di" bpmnElement="query-horeca-vergunning">
        <dc:Bounds x="370" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="end-event">
        <dc:Bounds x="582" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="564" y="225" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="200" />
        <di:waypoint x="370" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="470" y="200" />
        <di:waypoint x="582" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
